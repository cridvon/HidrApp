# Copiar a .env y completar. NUNCA subir el .env al repositorio.
PORT=3000
# Conexión a PostgreSQL con PostGIS (local o Supabase)
DATABASE_URL=postgres://usuario:password@localhost:5432/hidrapp
# true cuando la base exige SSL (por ejemplo Supabase)
DATABASE_SSL=false
# Clave para firmar los tokens JWT: usar un valor largo y aleatorio
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
# Origen(es) permitidos para el frontend, separados por coma. * permite todos
CORS_ORIGIN=http://localhost:5173
